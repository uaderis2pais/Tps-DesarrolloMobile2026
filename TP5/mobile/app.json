{
  "expo": {
    "name": "Network QoS Monitor",
    "slug": "network-qos-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "networkqos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.networkqos.monitor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permitir acceso a la ubicación para georreferenciar las métricas de calidad de red (QoS).",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permitir georreferenciación en segundo plano durante muestreos de cobertura móvil."
      }
    },
    "android": {
      "package": "com.networkqos.monitor",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite registrar las métricas de red y el mapa de calor de cobertura personal."
        }
      ]
    ]
  }
}
